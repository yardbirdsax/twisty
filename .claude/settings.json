{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "prompt",
                        "prompt": "The agent wants to run '$ARGUMENTS'. If this command includes command substitution for capturing text (e.g. `git commit -m \"$(cat..\"`), respond with {\"ok\": false, \"reason\": \"DO NOT use command substitution when capturing text. Use a different approach, like just in-lining the text.\"}."
                    },
                    {
                        "type": "prompt",
                        "prompt": "The agent wants to run: $ARGUMENTS. If this command tries to use temporary directories, like '/tmp' or '/private', respond {\"ok\": false, \"reason\": \"Use a directory in the current worktree called '.tmp'. If this directory isn't already in the '.gitignore' file, add it.\"}."
                    }
                ]
            }
        ]
    },
    "permissions": {
        "allow": [
            "Bash(git add:*)",
            "Bash(git commit:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(rtk go build:*)",
            "Bash(rtk go get:*)",
            "Bash(rtk go mod:*)",
            "Bash(rtk *)",
            "Bash(go vet:*)",
            "Bash(echo \"exit=$?\")",
            "Edit",
            "Read",
            "Write"
        ],
        "deny": [
            "Bash(git push --force)"
        ]
    },
    "sandbox": {
        "autoAllowBashIfSandboxed": true,
        "enabled": true,
        "excludedCommands": [
            "go test*",
            "rtk *"
        ],
        "filesystem": {
            "allowWrite": [
                "~/go/**",
                "~/Library/Caches/go-build"
            ],
            "allowRead": [
                "~/.twisty/**"
            ]
        },
        "network": {
            "allowedDomains": [
                "valhalla1.openstreetmap.de",
                "nominatim.openstreetmap.org",
                "overpass-api.de",
                "proxy.golang.org"
            ],
            "allowLocalBinding": true
        }
    }
}